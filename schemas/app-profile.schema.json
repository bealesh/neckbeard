{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app-profile.schema.json",
  "title": "app-profile.yaml — agent-written, user-reviewed application profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "services", "needs"],
  "properties": {
    "version": { "const": 1 },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "kind": { "enum": ["http", "worker", "cron"] },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "health_path": { "type": "string" },
          "schedule": { "type": "string", "description": "cron expression; kind=cron only" },
          "dockerfile": { "type": "string" },
          "command": {
            "description": "Omitted or empty preserves image defaults. A nonempty command replaces CMD arguments, not ENTRYPOINT.",
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "mode"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "mode": {
            "enum": ["provision", "reference", "undecided"],
            "description": "undecided is draft-only; reference consumes an existing service through secret_name"
          },
          "secret_name": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/evidenceList" }
        },
        "allOf": [{
          "if": { "properties": { "mode": { "const": "provision" } } },
          "then": { "properties": {
            "capability": { "enum": ["postgres", "object-storage", "secrets"] }
          } }
        }]
      }
    },
    "secrets": {
      "description": "Secret NAMES and reference paths only. Values must never appear in this file.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "ref": { "type": "string" }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "evidence": { "$ref": "#/$defs/evidenceList" }
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "confidence": { "enum": ["low", "medium", "high"] },
          "reasoning": { "type": "string" },
          "derived_from": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" }
        }
      }
    },
    "confirmed": {
      "description": "Answers to questions repository inspection cannot settle (traffic, availability, RPO/RTO, existing managed services).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "answer"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "answer": { "type": "string" }
        }
      }
    },
    "unsupported": {
      "description": "Out-of-contract needs. Named findings, never force-fit onto the catalog.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "detected", "explanation"],
        "properties": {
          "capability": { "type": "string" },
          "detected": { "type": "string" },
          "explanation": { "type": "string" },
          "nearest_supported": { "type": "string" },
          "disposition": { "enum": ["external", "not-required"] },
          "resolution": { "type": "string", "minLength": 1 },
          "secret_name": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/evidenceList" }
        }
      }
    }
  },
  "$defs": {
    "evidenceList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
