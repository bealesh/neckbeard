{
  "description": "At session start, reports whether the neckbeard CLI is on PATH and where the installer lives. Read-only: it never downloads or installs anything.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 5,
            "statusMessage": "Checking for the neckbeard CLI..."
          }
        ]
      }
    ]
  }
}
